MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=yaho_loader
MYSQL_PASSWORD=CHANGE_MYSQL_PASSWORD
MYSQL_DATABASE=tour_earlywarning

# 공공데이터포털에서 발급된 일반 인증키(Decoding)를 입력합니다.
# Encoding 키를 넣어도 수집기가 한 번 디코딩하여 처리합니다.
DATA_GO_KR_SERVICE_KEY=CHANGE_DATA_GO_KR_SERVICE_KEY

# 서로 다른 키를 써야 할 때만 아래 값을 입력합니다. 비우면 위 공통 키를 사용합니다.
TOUR_API_SERVICE_KEY=
KMA_API_SERVICE_KEY=

# 수집 범위: 현재 일별 이상탐지 공통 구간
COLLECTION_START_DATE=2023-01-01
COLLECTION_END_DATE=2026-08-31

# 기상특보 지점코드. 비우면 전국 특보 목록을 요청합니다.
KMA_WARNING_STN_ID=

