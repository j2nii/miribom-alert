# 이 내용을 C:\Users\han\yaho\.env에 추가하세요.
# 코드 파일에 API 키를 직접 입력하지 마세요.
NAVER_KEY_ID=실제_네이버_API_KEY_ID
NAVER_KEY_SECRET=실제_네이버_API_KEY_SECRET

# MySQL 계정은 ..\yaho_mysql_setup\.env에 기존값을 사용합니다.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=yaho_loader
MYSQL_PASSWORD=실제_로더_비밀번호
MYSQL_DATABASE=tour_earlywarning
