{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tourism-early-warning/schema/signal_status.schema.json",
  "title": "signal_status — 현재 경보 단계와 3중 교차검증 결과",
  "description": "AREA 0 관제 대시보드의 최상단. 단일 지표가 아니라 3개 독립 신호의 합의로 단계를 판정한다.",
  "allOf": [{ "$ref": "_envelope.schema.json" }],
  "properties": {
    "data": {
      "type": "object",
      "required": ["region", "as_of", "alert_level", "congestion_level", "cross_validation", "agreement", "basis"],
      "properties": {
        "region": { "$ref": "_envelope.schema.json#/definitions/region" },
        "as_of": { "$ref": "_envelope.schema.json#/definitions/date" },
        "alert_level": { "$ref": "_envelope.schema.json#/definitions/alert_level" },
        "previous_alert_level": { "$ref": "_envelope.schema.json#/definitions/alert_level" },
        "congestion_level": { "$ref": "_envelope.schema.json#/definitions/congestion_level" },
        "density": {
          "type": "object",
          "description": "밀도 실측/추정치. 경사지는 slope_corrected를 사용한다 (매뉴얼 p.53).",
          "required": ["value", "unit"],
          "properties": {
            "value": { "type": "number", "minimum": 0 },
            "unit": { "type": "string", "enum": ["명/㎡"] },
            "slope_corrected": { "type": "boolean" },
            "slope_degree": { "type": "number" },
            "k_factor": { "type": "number", "description": "경사 보정계수 K = 경사 보행속도 ÷ 평지 보행속도(1.33m/s)" }
          }
        },
        "cross_validation": {
          "type": "array",
          "description": "3중 교차검증. 서로 다른 출처의 독립 신호 3개를 고정한다.",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["signal", "provider", "value", "threshold", "exceeded"],
            "properties": {
              "signal": { "type": "string", "description": "예: 이동통신 유동인구 증가율" },
              "provider": { "type": "string" },
              "value": { "type": "number" },
              "threshold": { "type": "number" },
              "unit": { "type": "string" },
              "exceeded": { "type": "boolean", "description": "임계 초과 여부" },
              "trend": { "type": "string", "enum": ["상승", "유지", "하락"] }
            }
          }
        },
        "agreement": {
          "type": "object",
          "description": "몇 개 신호가 임계를 넘었는가. 2/3 이상이면 경보 상향.",
          "required": ["exceeded_count", "total"],
          "properties": {
            "exceeded_count": { "type": "integer", "minimum": 0, "maximum": 3 },
            "total": { "type": "integer", "const": 3 }
          }
        },
        "basis": {
          "type": "string",
          "minLength": 10,
          "description": "판정 근거를 사람이 읽는 한 문장으로. 화면에 그대로 노출된다."
        },
        "manual_ref": { "$ref": "_envelope.schema.json#/definitions/manual_ref" }
      }
    }
  }
}
