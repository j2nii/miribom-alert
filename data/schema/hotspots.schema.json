{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tourism-early-warning/schema/hotspots.schema.json",
  "title": "hotspots — 급증 지점 랭킹 (현지인/외지인 구분)",
  "description": "어디가 문제인가. spatial_type이 붙어야 에이전트③이 매뉴얼 조치를 걸 수 있다 (매뉴얼 p.13 유형 4분류).",
  "allOf": [{ "$ref": "_envelope.schema.json" }],
  "properties": {
    "data": {
      "type": "object",
      "required": ["region", "ranking"],
      "properties": {
        "region": { "$ref": "_envelope.schema.json#/definitions/region" },
        "baseline_period": {
          "$ref": "_envelope.schema.json#/definitions/period",
          "description": "증감률 산출의 기준 기간"
        },
        "ranking": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["rank", "poi_name", "visitors", "change_rate", "spatial_type"],
            "properties": {
              "rank": { "type": "integer", "minimum": 1 },
              "poi_name": { "type": "string" },
              "poi_id": { "type": "string" },
              "coord": {
                "type": "object",
                "required": ["lat", "lng"],
                "properties": {
                  "lat": { "type": "number", "minimum": 33, "maximum": 39 },
                  "lng": { "type": "number", "minimum": 124, "maximum": 132 }
                }
              },
              "visitors": { "type": "integer", "minimum": 0 },
              "change_rate": { "type": "number", "description": "기준 기간 대비 증감률. 0.35 = +35%" },
              "visitor_mix": {
                "type": "object",
                "description": "현지인/외지인 구분. 현지인 비중이 높은 지점의 혼잡은 정주권 문제로 다룬다.",
                "required": ["local", "external"],
                "properties": {
                  "local": { "$ref": "_envelope.schema.json#/definitions/ratio" },
                  "external": { "$ref": "_envelope.schema.json#/definitions/ratio" }
                }
              },
              "congestion_level": { "$ref": "_envelope.schema.json#/definitions/congestion_level" },
              "spatial_type": { "$ref": "_envelope.schema.json#/definitions/spatial_type" },
              "bottleneck": {
                "type": "object",
                "description": "병목 구간 정보. 매뉴얼 Tier2 KPI '병목 구간 체류 시간'.",
                "properties": {
                  "name": { "type": "string" },
                  "dwell_minutes": { "type": "number", "minimum": 0 },
                  "avg_speed_mps": { "type": "number", "minimum": 0 }
                }
              }
            }
          }
        }
      }
    }
  }
}
