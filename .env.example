# 이 파일을 복사해 .env 로 만들고 값을 채운다. .env는 커밋되지 않는다.

# YouTube Data API v3 (Google Cloud Console > 사용자 인증 정보 > API 키)
# 쿼터: 하루 10,000 units / search.list = 100 units, videos.list = 1 unit
YOUTUBE_API_KEY=

# 에이전트 실행용 LLM 키 (선택 — 둘 중 하나만 있어도 된다. 둘 다 없으면 --dump-prompt / replay만 가능)
# LLM_PROVIDER를 비워 두면 ANTHROPIC_API_KEY → UPSTAGE_API_KEY 순으로 있는 키를 쓴다
ANTHROPIC_API_KEY=
UPSTAGE_API_KEY=

# 선택 설정
# LLM_PROVIDER=upstage          # anthropic | upstage | openai(로컬) | replay
# LLM_MODEL=solar-pro3          # 비우면 백엔드 기본값 (upstage는 solar-pro3 — 무료 모델만 쓴다)
# LLM_REASONING_EFFORT=medium   # upstage 추론 강도 low | medium | high

# 팀 MySQL (collection/db_export.py) — 주소·비밀번호는 팀 채팅 공지 참고 (저장소에 적지 않는다). 계정은 본인 것을 쓴다
DB_HOST=
DB_PORT=3306
DB_NAME=tour_earlywarning
DB_USER=
DB_PASSWORD=
