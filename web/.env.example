# web/.env.example -- 이 파일을 복사해 .env(로컬) 또는 Vercel 프로젝트 환경변수로 설정한다.
# VITE_ 접두사가 붙은 값만 브라우저 번들에 노출된다 -- UPSTAGE_API_KEY는 절대
# VITE_ 접두사를 붙이지 말 것 (api/briefing.js에서 서버 사이드에서만 읽는다).

VITE_USE_PROD=false

# AI 정책 초안 도우미(web/api/briefing.js)가 사용하는 서버 전용 키.
# Upstage Solar(OpenAI 호환 엔드포인트, base_url https://api.upstage.ai/v1)를 호출한다.
UPSTAGE_API_KEY=

# 기본값은 solar-pro4 (콘솔 API 키 발급 화면 예시 기준). 다른 모델을 쓰려면
# 여기 채워서 덮어쓴다.
UPSTAGE_MODEL=

# 로컬에서 이 엔드포인트를 테스트하려면 `vite dev`가 아니라 `vercel dev`로
# 실행해야 한다 (Vite 단독 dev 서버는 /api 함수를 실행하지 않는다) -- 키가
# 없거나 호출이 실패하면 화면은 규칙 기반 생성으로 자동 대체된다.
