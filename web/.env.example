# web/.env.example -- 이 파일을 복사해 .env(로컬) 또는 Vercel 프로젝트 환경변수로 설정한다.
# VITE_ 접두사가 붙은 값만 브라우저 번들에 노출된다 -- UPSTAGE_API_KEY는 절대
# VITE_ 접두사를 붙이지 말 것 (api/query.js에서 서버 사이드에서만 읽는다).

VITE_USE_PROD=true

# 자연어 질의 인터페이스(web/api/query.js, AREA0 채팅)가 사용하는 서버 전용 키.
# Upstage Solar(OpenAI 호환 엔드포인트, base_url https://api.upstage.ai/v1)를 호출한다.
# (AI 정책 초안 도우미는 더 이상 라이브 LLM 호출을 쓰지 않음 -- agent5_briefing.py가
# 생성한 data/prod/briefing.json을 정적으로 읽는다. docs/j2nii_진행상황.md 참고.)
UPSTAGE_API_KEY=

# 기본값은 solar-pro4 (콘솔 API 키 발급 화면 예시 기준). 다른 모델을 쓰려면
# 여기 채워서 덮어쓴다.
UPSTAGE_MODEL=

# 로컬에서 이 엔드포인트를 테스트하려면 `vite dev`가 아니라 `vercel dev`로
# 실행해야 한다 (Vite 단독 dev 서버는 /api 함수를 실행하지 않는다) -- 또는
# `npm run dev:api`(dev-server.mjs)로 대체 가능.

# MySQL 관련 환경변수는 더 이상 web/ 쪽에서 쓰지 않는다 -- signal_status/timeline
# 등은 agents/ 파이프라인(judge_signal_status.py 등)이 만든 data/prod/*.json을
# 읽는 방식으로 되돌렸다. DB에 직접 붙는 코드가 필요해지면 그건 agents/ 쪽에서
# 관리해야 한다 (docs/meeting-notes/UI/MySQL_실데이터_연동_계획.md 참고).